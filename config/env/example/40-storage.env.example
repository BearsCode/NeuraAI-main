# S3-compatible object storage
S3__BACKEND=s3
S3__ENDPOINT_URL=https://s3.example.com
S3__ACCESS_KEY_ID=change-me
S3__SECRET_ACCESS_KEY=change-me
S3__BUCKET=neura-media
S3__REGION=eu-central-1
S3__PUBLIC_BASE_URL=https://cdn.example.com/neura-media
S3__USE_PATH_STYLE=false
S3__SIGNED_URL_TTL_SECONDS=900
S3__LOCAL_ROOT=./storage/uploads
S3__MAX_UPLOAD_SIZE_MB=25
S3__ALLOWED_UPLOAD_CONTENT_TYPES=["image/jpeg","image/png","image/webp","video/mp4","application/pdf"]
