# HTTP/API surface
WEB__API_V1_PREFIX=/api/v1
# Optional. Set to /api/v2 only when a real v2 contract is released.
WEB__API_V2_PREFIX=
WEB__PUBLIC_BASE_URL=https://api.example.com
WEB__DOCS_ENABLED=false
WEB__OPENAPI_ENABLED=true
WEB__CORS_ORIGINS=["https://app.example.com"]
WEB__REQUEST_ID_HEADER=X-Request-ID
WEB__DOMAIN=example.com
