# Root runtime overrides for docker compose.
# The canonical backend templates still live under `config/env/example/*.env.example`.

NEURA_ENV_PROFILE=local
APP__ENV=local

APP_PORT=8000
FRONTEND_PORT=3000

# Production reverse proxy / TLS
WEB__DOMAIN=example.com
WEB__PUBLIC_BASE_URL=https://example.com
LETSENCRYPT_EMAIL=ops@example.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
CERTBOT_RENEW_INTERVAL_SECONDS=43200

# Email
EMAIL__PROVIDER=console

# Avatar (HeyGen / Replicate)
AVATAR__HEYGEN__API_KEY=
AVATAR__REPLICATE__API_KEY=

# AI / LLM
AI__PROVIDER=mock
AI__OPENAI__API_KEY=
AI__OPENAI__BASE_URL=https://api.openai.com/v1
AI__OPENAI__MODEL=gpt-4o-mini

# Retail integrations
RETAIL__C1_ENABLED=false
RETAIL__MOYSKLAD_ENABLED=false

